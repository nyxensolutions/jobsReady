generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SEEKER
  EMPLOYER
  ADMIN
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  CLOSED
  REJECTED
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  REJECTED
  HIRED
}

enum EmployerStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  GIG
  WALK_IN
}

enum PlanType {
  SINGLE_HIRE
  MULTI_HIRE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

// ─── Core ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  role      UserRole @default(SEEKER)
  locale    String   @default("en")
  isActive  Boolean  @default(true)
  fcmTokens String[] @default([]) // mobile push notification device tokens
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seekerProfile   SeekerProfile?
  employerProfile EmployerProfile?
  notifications   Notification[]

  @@map("users")
}

model SeekerProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  name                String
  city                String?
  pincode             String?
  stateCode           String?
  experienceYears     Int       @default(0)
  skills              String[]
  preferredJobTypes   JobType[]
  preferredCategories String[]
  resumeUrl           String?
  photoUrl            String?
  bio                 String?
  isProfileComplete   Boolean   @default(false)
  isOpenToWork        Boolean   @default(true)
  openToRelocate      Boolean   @default(true)
  preferredCities     String[]
  languages           String[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  savedJobs    SavedJob[]

  @@map("seeker_profiles")
}

model EmployerProfile {
  id            String         @id @default(uuid())
  userId        String         @unique
  companyName   String
  gstCin        String?
  industry      String?
  contactPerson String?
  contactPhone  String?
  city          String?
  stateCode     String?
  pincode       String?
  website       String?
  logoUrl       String?
  description   String?
  status        EmployerStatus @default(PENDING)
  verifiedAt    DateTime?
  docUrls       String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListings   JobListing[]
  subscriptions Subscription[]

  @@map("employer_profiles")
}

// ─── Jobs ────────────────────────────────────────────────────────────────────

model Category {
  id        String  @id @default(uuid())
  slug      String  @unique
  nameEn    String
  nameHi    String?
  nameTe    String?
  nameTa    String?
  nameKn    String?
  nameBn    String?
  namePa    String?
  icon      String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  jobListings JobListing[]

  @@map("categories")
}

model City {
  id        String  @id @default(uuid())
  name      String
  nameHi    String?
  slug      String  @unique
  stateCode String
  stateName String
  isActive  Boolean @default(true)

  jobListings JobListing[]

  @@map("cities")
}

model JobListing {
  id            String    @id @default(uuid())
  employerId    String
  categoryId    String
  cityId        String
  title         String
  description   String
  salaryMin     Int?
  salaryMax     Int?
  salaryUnit    String    @default("monthly")
  vacancies     Int       @default(1)
  jobType       JobType   @default(FULL_TIME)
  experienceMin Int       @default(0)
  pincode       String?
  requirements  String[]
  perks         String[]
  status        JobStatus @default(PENDING_REVIEW)
  isFeatured    Boolean   @default(false)
  viewCount     Int       @default(0)
  qualificationRequired String?
  languagesRequired     String[]
  source        String    @default("EMPLOYER")
  sourceUrl     String?
  lastScrapedAt DateTime?
  expiresAt     DateTime?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  isHighReach      Boolean  @default(false)

  // ── Call-to-HR: employer can expose their phone for direct candidate calls ──
  callToHrEnabled  Boolean  @default(false)
  callToHrPhone    String?

  employer     EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  category     Category        @relation(fields: [categoryId], references: [id])
  city         City            @relation(fields: [cityId], references: [id])
  applications Application[]
  savedBy      SavedJob[]
  boost        JobBoost?

  @@index([status, cityId])
  @@index([status, categoryId])
  @@index([employerId])
  @@map("job_listings")
}

model Application {
  id        String            @id @default(uuid())
  jobId     String
  seekerId  String
  status    ApplicationStatus @default(APPLIED)
  coverNote String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  job    JobListing    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([jobId, seekerId])
  @@index([seekerId])
  @@map("applications")
}

model SavedJob {
  id        String   @id @default(uuid())
  seekerId  String
  jobId     String
  createdAt DateTime @default(now())

  seeker SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  job    JobListing    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([seekerId, jobId])
  @@index([seekerId])
  @@map("saved_jobs")
}

// ─── OTP ─────────────────────────────────────────────────────────────────────

model OtpCode {
  phone     String   @id
  otp       String
  expiresAt DateTime

  @@map("otp_codes")
}

// ─── Plans & Payments ────────────────────────────────────────────────────────

model Plan {
  id                     String   @id @default(uuid())
  slug                   String   @unique
  name                   String
  type                   PlanType
  durationDays           Int
  priceRupees            Int      // full upfront price in ₹
  activeJobLimit         Int
  candidateUnlockCredits Int
  boostCredits           Int
  isPopular              Boolean  @default(false)
  isTrial                Boolean  @default(false)
  isActive               Boolean  @default(true)
  sortOrder              Int      @default(0)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  employerId           String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  startedAt            DateTime           @default(now())
  expiresAt            DateTime
  candidateUnlocksUsed Int                @default(0)
  boostsUsed           Int                @default(0)
  razorpayOrderId      String?
  razorpayPaymentId    String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  employer         EmployerProfile   @relation(fields: [employerId], references: [id], onDelete: Cascade)
  plan             Plan              @relation(fields: [planId], references: [id])
  candidateUnlocks CandidateUnlock[]
  jobBoosts        JobBoost[]

  @@index([employerId, status])
  @@map("subscriptions")
}

model CandidateUnlock {
  id             String   @id @default(uuid())
  employerId     String
  seekerId       String
  subscriptionId String
  unlockedAt     DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([employerId, seekerId])
  @@index([employerId])
  @@map("candidate_unlocks")
}

model JobBoost {
  id             String   @id @default(uuid())
  jobId          String   @unique
  employerId     String
  subscriptionId String
  boostedAt      DateTime @default(now())
  expiresAt      DateTime

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  job          JobListing   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@map("job_boosts")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
